DATABASE_URL="postgresql://user:password@localhost:5432/mocktestseries?schema=public"

# Generate with: openssl rand -base64 32
AUTH_STUDENT_SECRET=""
AUTH_ADMIN_SECRET=""

# Local-disk file storage (lib/storage). Relative paths resolve against the app's cwd; in
# production point this at a path outside the deployed source tree (e.g. a mounted data volume).
UPLOAD_DIR="storage/uploads"

# Optional. Powers the "AI explanation" button on the results page (lib/ai/explainQuestion.ts).
# Without it, the button reports the feature as unavailable instead of failing the request.
ANTHROPIC_API_KEY=""
