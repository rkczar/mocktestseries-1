generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

// FULL_ADMIN is stored in the database as "ADMIN" (@map) — this is a pure
// rename of the exported name, not a data migration. Per the RBAC redesign,
// FULL_ADMIN is global read-only on the Question Bank and the Exams domain
// (Exams, Subjects, Topics, Syllabus, Previous Year Papers, Test Series —
// see DEFAULT_ROLE_PERMISSIONS in lib/permissions.ts); it is unchanged for
// every other admin area (Website, Tests, Students, etc.).
enum RoleName {
  MASTER_ADMIN
  FULL_ADMIN   @map("ADMIN")
  TEACHER
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  adminUsers  AdminUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminUser {
  id                     String            @id @default(cuid())
  name                   String
  username               String            @unique
  email                  String?           @unique
  passwordHash           String
  roleId                 String
  role                   Role              @relation(fields: [roleId], references: [id])
  isActive               Boolean           @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  auditLogs              AuditLog[]
  loginAttempts          LoginAttempt[]
  deletionReviews        DeletionRequest[]
  createdCustomModules   CustomModule[]
  bulkImportRuns         BulkImportRun[]
  createdGrandTests      GrandTest[]
  createdLiveTests       LiveTest[]
  createdAnnouncements   Announcement[]
  assignedCommunications Communication[]
  aiExplanationReviews   AIExplanation[]   @relation("AiExplanationReviewedBy")
  createdTestResources   TestResource[]
}

model LoginAttempt {
  id          String     @id @default(cuid())
  username    String
  ipAddress   String
  success     Boolean
  createdAt   DateTime   @default(now())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([username, ipAddress, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content stubs (minimal now, expanded in Phase 7/9)
// ---------------------------------------------------------------------------

model Exam {
  id                  String    @id @default(cuid())
  name                String
  code                String    @unique
  year                Int?
  // Canonical exam date shown on admin/public exam detail pages. Distinct
  // from `year` (a plain calendar year label) and `upcomingDate` (only used
  // for the homepage's "days left" countdown while isUpcoming is true) —
  // this is the general-purpose "when this exam happens" field.
  examDate            DateTime?
  description         String?
  isActive            Boolean   @default(true)
  isUpcoming          Boolean   @default(false)
  upcomingDate        DateTime?
  order               Int       @default(0)
  negativeMarking     Float?
  durationMinutes     Int?
  instructions        String?
  // Syllabus (Admin -> Exams -> Syllabus). The Subject/Topic hierarchy itself
  // is the same canonical taxonomy Question Bank and bulk import already use
  // — this flag/description are the only syllabus-specific state that
  // doesn't already exist elsewhere. Disabled (the default) hides the public
  // syllabus section entirely rather than showing an empty one.
  syllabusEnabled     Boolean   @default(false)
  syllabusDescription String?

  // Public exam landing page (/exams, /exams/[slug]). Deliberately separate
  // from `isActive` — an exam can stay fully operational in Admin/student
  // systems while its public marketing page is hidden. Disabled by default;
  // nothing here is populated automatically, only by an admin.
  publicPageEnabled   Boolean @default(false)
  publicSlug          String? @unique
  shortDescription    String?
  overview            String?
  conductingAuthority String?
  eligibility         String?
  examPatternInfo     String?
  // Structured pattern facts, kept separate from the free-text
  // `examPatternInfo` so the public page can render them in a stat grid
  // without parsing prose. Official exam-mode label (e.g. "Offline (OMR)",
  // "Online (CBT)") — freeform rather than an enum since it's editorial.
  totalQuestions      Int?
  totalMarks          Int?
  examMode            String?
  // Array of { label: string, date: string } — kept as freeform Json rather
  // than a table since it's small, editorial, and has no relational queries.
  importantDates      Json?
  // Array of { question: string, answer: string }.
  faqItems            Json?
  seoTitle            String?
  seoDescription      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects           Subject[]
  previousYearPapers PreviousYearPaper[]
  testSeries         TestSeries[]
  questions          Question[]
  mockTests          MockTest[]
  customModules      CustomModule[]
  testAttempts       TestAttempt[]
  grandTests         GrandTest[]
  liveTests          LiveTest[]
  enrollments        StudentExamEnrollment[]
  announcements      Announcement[]
  bulkImportRuns     BulkImportRun[]
  testResources      TestResource[]
  products           Product[]
}

model Subject {
  id                  String        @id @default(cuid())
  examId              String
  exam                Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  name                String
  order               Int           @default(0)
  syllabusDescription String?
  topics              Topic[]
  questions           Question[]
  testAttempts        TestAttempt[]
  createdAt           DateTime      @default(now())
}

model Topic {
  id                  String   @id @default(cuid())
  subjectId           String
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name                String
  order               Int      @default(0)
  syllabusDescription String?
  createdAt           DateTime @default(now())

  subTopics SubTopic[]
  questions Question[]
}

model PreviousYearPaper {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  year      Int
  title     String
  // Distinguishes multiple papers/sets within the same exam+year (e.g. "Code
  // 12"). Optional — many exams only ever have one paper per year.
  paperCode String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  questions      Question[]
  testAttempts   TestAttempt[]
  bulkImportRuns BulkImportRun[]
}

enum TestSeriesStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TestSeries {
  id            String           @id @default(cuid())
  examId        String
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  instructions  String?
  coverImageUrl String?
  // PLANNED number of Mock Tests in the series (e.g. 50) — a target the
  // public page shows as "50 Mock Tests Planned", never as available. Real
  // published/available counts are always derived from MockTest rows.
  testCount     Int              @default(0)
  // Public URL segment for the series landing page. The canonical exam
  // series (the one whose slug is "mock-test-series") is served at
  // /exams/[examSlug]/mock-test-series — see lib/mock-series.ts.
  slug          String?          @unique
  isActive      Boolean          @default(true)
  // Lifecycle status (Test Series Control Center). Distinct from `isActive`,
  // which remains the existing homepage/quick-toggle flag — status governs
  // whether the series appears at all in the admin Control Center's
  // Published/Upcoming/Available counts and student-facing hub.
  status        TestSeriesStatus @default(DRAFT)
  order         Int              @default(0)
  createdAt     DateTime         @default(now())

  mockTests MockTest[]
  resources TestResource[]
  products  Product[]
}

// ---------------------------------------------------------------------------
// Universal Appearance
// ---------------------------------------------------------------------------

model AppearanceConfig {
  id             String   @id @default(cuid())
  isActive       Boolean  @default(true)
  colors         Json
  fonts          Json
  buttonStyle    Json
  componentStyle Json
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Route Registry / Website Diagram
// ---------------------------------------------------------------------------

enum RouteUserType {
  PUBLIC
  STUDENT
  ADMIN
}

enum RouteStatus {
  CONNECTED
  WARNING
  BROKEN
  ORPHAN
  UNAUTHORIZED
  DRAFT
}

model RouteRegistryEntry {
  id           String        @id @default(cuid())
  pageName     String
  route        String        @unique
  module       String
  userType     RouteUserType
  authRequired Boolean       @default(false)
  parentRoute  String?
  status       RouteStatus   @default(CONNECTED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Public Page Visibility (Admin -> Website -> Website Content)
// ---------------------------------------------------------------------------

// One row per toggleable static public page (Homepage, Exam Directory,
// Contact, Privacy, Terms, ...). Exam landing pages are NOT tracked here —
// they use Exam.publicPageEnabled/publicSlug directly, since visibility
// there is inherently a per-exam concept. Both are gated the same way:
// MASTER_ADMIN mutates, FULL_ADMIN reads only (see lib/rbac.ts requireRole).
// Turning a page off never deletes data — it only hides the route/nav/
// sitemap entry; the underlying content is untouched and returns when
// switched back on.
model PageVisibility {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  route       String
  isVisible   Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Homepage
// ---------------------------------------------------------------------------

enum HomepageConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomepageSectionKey {
  HEADER
  HERO
  FEATURED_EXAM
  MOCK_TEST_PROMOTION
  PREVIOUS_YEAR_PAPERS
  AI_USP
  BENEFITS
  HOW_IT_WORKS
  STATISTICS
  UPCOMING_EXAMS
  TEST_SERIES
  CTA
  FOOTER
  CONTACT_INFO
}

model HomepageConfig {
  id          String               @id @default(cuid())
  version     Int
  status      HomepageConfigStatus @default(DRAFT)
  seo         Json?
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sections    HomepageSection[]

  @@unique([version])
}

model HomepageSection {
  id               String             @id @default(cuid())
  homepageConfigId String
  homepageConfig   HomepageConfig     @relation(fields: [homepageConfigId], references: [id], onDelete: Cascade)
  key              HomepageSectionKey
  isEnabled        Boolean            @default(true)
  order            Int                @default(0)
  content          Json
  references       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([homepageConfigId, key])
}

// ---------------------------------------------------------------------------
// Settings (key-value, fleshed out in Phase 11)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Student identity & auth
//
// Fully separate from AdminUser/RBAC by design: a second next-auth instance
// (lib/auth-student.ts) issues its own session cookie, so an admin session
// and a student session can never be the same credential. Google sign-in
// links via StudentOAuthAccount (no Prisma Adapter — JWT sessions, same
// pattern as the admin Credentials provider). Mobile OTP is verified against
// OtpRequest by a Credentials provider named "otp".
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum StudentAuthProvider {
  CREDENTIALS
  GOOGLE
  OTP
}

enum OAuthProviderName {
  GOOGLE
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Single-row atomic counter backing the human-readable studentId (e.g. MTS-000123).
 */
model StudentIdCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

model Student {
  id           String              @id @default(cuid())
  studentId    String              @unique
  name         String
  email        String?             @unique
  mobile       String?             @unique
  passwordHash String?
  authProvider StudentAuthProvider
  status       StudentStatus       @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  profile                 StudentProfile?
  oauthAccounts           StudentOAuthAccount[]
  loginAttempts           StudentLoginAttempt[]
  deletionRequests        DeletionRequest[]
  testAttempts            TestAttempt[]
  answers                 Answer[]
  savedQuestions          SavedQuestion[]
  activities              StudentActivity[]
  reportedQuestions       ReportedQuestion[]
  customModules           CustomModule[]             @relation("StudentCustomModules")
  examEnrollments         StudentExamEnrollment[]
  notificationStates      StudentNotificationState[]
  announcementRecipientOf AnnouncementRecipient[]
  communications          Communication[]

  entitlements      StudentEntitlement[]
  couponRedemptions CouponRedemption[]
  paymentOrders     PaymentOrder[]
  payments          Payment[]
  invoices          Invoice[]

  @@index([status])
}

model StudentProfile {
  studentId    String   @id
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  photoUrl     String?
  bio          String?
  targetExamId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudentOAuthAccount {
  id                String            @id @default(cuid())
  studentId         String
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  provider          OAuthProviderName
  providerAccountId String
  email             String?
  createdAt         DateTime          @default(now())

  @@unique([provider, providerAccountId])
}

/**
 * OTP codes are hashed at rest; never store the plaintext code.
 * When delivery goes through the MSG91 Widget API, MSG91 generates and holds
 * the actual code — `otpHash` is a random, never-checked placeholder for that
 * case (kept non-null so the column needs no special-casing) and `providerRef`
 * holds MSG91's `reqId`, which verifyOtp needs to check the code with MSG91.
 */
model OtpRequest {
  id          String     @id @default(cuid())
  mobile      String
  purpose     OtpPurpose
  otpHash     String
  providerRef String?
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  lastSentAt  DateTime   @default(now())
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
}

model StudentLoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String
  success    Boolean
  method     String?
  createdAt  DateTime @default(now())
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])

  @@index([identifier, ipAddress, createdAt])
  @@index([method, createdAt])
}

model DeletionRequest {
  id                String                @id @default(cuid())
  studentId         String
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason            String?
  status            DeletionRequestStatus @default(PENDING)
  requestedAt       DateTime              @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   AdminUser?            @relation(fields: [reviewedByAdminId], references: [id])
  notes             String?

  // Immutable deletion-time audit snapshot (lib/student-lifecycle.ts). Taken
  // when the request is created and re-taken inside the approval transaction
  // BEFORE the Student row is anonymized, so Admin history never depends on
  // the live Student relation. Contact fields are MASKED on write — the raw
  // email/phone is never copied here, and no credential/token ever is.
  studentCodeSnapshot         String?
  studentNameSnapshot         String?
  emailMaskedSnapshot         String?
  phoneMaskedSnapshot         String?
  reviewedByAdminNameSnapshot String?

  @@index([status])
  @@index([studentId, status])
}

// ---------------------------------------------------------------------------
// Question Bank
//
// Admin-owned content, read-only from the student side. Exam/Subject/Topic
// already exist; SubTopic and PreviousYearPaper-linkage are additive here.
// ---------------------------------------------------------------------------

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * Where a question came from. QUESTION_BANK = authored for the bank;
 * PYQ = a previous-year paper question (mirrors previousYearPaperId).
 */
enum QuestionSource {
  QUESTION_BANK
  PYQ
}

/**
 * Role of a question inside the AI variant system.
 */
enum AiVariantType {
  /**
   * The original question that AI variants hang off of.
   */
  CANONICAL
  /**
   * AI-generated rephrasing testing the same fact.
   */
  AI_SIMILAR
  /**
   * AI-generated lookalike that is deliberately wrong.
   */
  AI_TRAP
}

/**
 * Position a generated variant occupies under its canonical question (max 5).
 */
enum AiSlot {
  AI01
  AI02
  AI03
  AI04
  AI05
}

/**
 * One-shot lifecycle for AI variant/explanation generation.
 */
enum AiGenerationStatus {
  /**
   * Ordinary bank/PYQ question, nothing requested yet.
   */
  NONE
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model SubTopic {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  questions Question[]
}

/**
 * Per-scope atomic counter backing canonical human-readable Question codes
 * (e.g. "RUHS MO 2024 W01"). scope = "<normalized exam code> <year>".
 * Monotonic per scope: deleted codes are never re-issued, re-imports never
 * renumber existing questions, and a sequence number is only consumed when
 * the transaction that allocates it commits (so invalid import rows never
 * burn numbers). See lib/question-code.ts.
 */
model QuestionCodeCounter {
  scope String @id
  value Int    @default(0)
}

model Question {
  id                  String             @id @default(cuid())
  code                String             @unique
  examId              String
  exam                Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId             String?
  topic               Topic?             @relation(fields: [topicId], references: [id])
  subTopicId          String?
  subTopic            SubTopic?          @relation(fields: [subTopicId], references: [id])
  previousYearPaperId String?
  previousYearPaper   PreviousYearPaper? @relation(fields: [previousYearPaperId], references: [id])
  text                String
  imageUrl            String?
  difficulty          QuestionDifficulty @default(MEDIUM)
  status              QuestionStatus     @default(DRAFT)
  source              QuestionSource     @default(QUESTION_BANK)
  examYear            Int?
  // AI variant provenance: canonical questions have no parent; AI_SIMILAR /
  // AI_TRAP variants point at the canonical row and carry an AI01–AI05 slot
  // plus a one-shot generation status. `@@unique([parentQuestionId, aiSlot])`
  // is the server-side max-5-per-question enforcement: aiSlot has exactly 5
  // possible values, so a parent can never accumulate more than 5 variant
  // rows, and two concurrent admins can never both claim the same slot.
  parentQuestionId    String?
  parentQuestion      Question?          @relation("AiQuestionVariants", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  aiVariantType       AiVariantType?
  aiSlot              AiSlot?
  aiGenerationStatus  AiGenerationStatus @default(NONE)
  // Provenance for a generated variant, mirroring AIExplanation's fields —
  // never mix output silently across prompt/model changes (Step 7.3).
  aiProvider          String?
  aiModel             String?
  aiPromptVersion     String?
  aiGeneratedAt       DateTime?
  aiErrorMessage      String?
  // Review/import provenance (Question Bank bulk-import workspace). A
  // question can be PUBLISHED/DRAFT and still need manual review (missing
  // image, uncertain taxonomy match, duplicate suspicion) — this is
  // orthogonal to status so nothing filtering by status silently changes.
  reviewRequired      Boolean            @default(false)
  reviewReason        String?
  importBatchId       String?
  importBatch         BulkImportRun?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  options               QuestionOption[]
  mockTestQuestions     MockTestQuestion[]
  customModuleQuestions CustomModuleQuestion[]
  grandTestQuestions    GrandTestQuestion[]
  liveTestQuestions     LiveTestQuestion[]
  savedByStudents       SavedQuestion[]
  reports               ReportedQuestion[]
  aiExplanation         AIExplanation?
  aiVariants            Question[]             @relation("AiQuestionVariants")
  aiExplanationVariants AIExplanationVariant[]

  @@unique([parentQuestionId, aiSlot])
  @@index([examId, examYear])
  @@index([examId, subjectId, topicId])
  @@index([topicId, subTopicId])
  @@index([previousYearPaperId, status])
  @@index([source, status])
  @@index([parentQuestionId])
  @@index([status])
  @@index([aiGenerationStatus])
  @@index([importBatchId])
  @@index([reviewRequired])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  text       String
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
}

// ---------------------------------------------------------------------------
// Mock Tests / Test Series
// ---------------------------------------------------------------------------

enum MockTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  FREE
  PAID
}

enum MockCoverageType {
  FULL_SYLLABUS
  PARTIAL_SYLLABUS
  SUBJECT_WISE
}

enum AttemptPolicy {
  SINGLE_ATTEMPT
  MULTIPLE_PRACTICE
}

model MockTest {
  id              String         @id @default(cuid())
  examId          String
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  testSeriesId    String?
  testSeries      TestSeries?    @relation(fields: [testSeriesId], references: [id])
  title           String
  description     String?
  durationMinutes Int
  negativeMarking Float          @default(0)
  instructions    String?
  accessType      AccessType     @default(FREE)
  status          MockTestStatus @default(DRAFT)
  // Scheduled release time. Null preserves today's behavior exactly — a
  // PUBLISHED test with no availableFrom is available immediately, so every
  // existing MockTest row is unaffected by this column's addition. Once set,
  // the test is UPCOMING/locked before this instant and AVAILABLE at and
  // after it, indefinitely (see lib/mock-test-schedule.ts) — there is no
  // availableUntil; Scheduled Mock Tests never auto-close, unlike LiveTest.
  availableFrom   DateTime?
  // Governs whether a student may submit this test more than once. Default
  // MULTIPLE_PRACTICE matches today's actual behavior (nothing currently
  // stops a retake) — only the leaderboard, via TestAttempt.isLeaderboardAttempt,
  // distinguishes a student's first submission from later practice retakes.
  attemptPolicy   AttemptPolicy  @default(MULTIPLE_PRACTICE)
  // What the test covers, shown on public/student cards. FULL_SYLLABUS needs
  // no selection; PARTIAL_SYLLABUS / SUBJECT_WISE list the real Subject /
  // Topic ids the admin picked (plain id arrays: display-only metadata, no
  // relational queries, and a deleted subject simply drops out on render).
  coverageType       MockCoverageType @default(FULL_SYLLABUS)
  coverageSubjectIds String[]         @default([])
  coverageTopicIds   String[]         @default([])
  // Admin's intended question count ("Selected X / Target Y"). Null = no target.
  targetQuestionCount Int?
  // Reused as "Test Number" — the test's display/sort position within its
  // Test Series (already existed for general ordering; no new field needed).
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questions     MockTestQuestion[]
  testAttempts  TestAttempt[]
  announcements Announcement[]
  resources     TestResource[]

  products Product[]

  @@index([examId, status])
  @@index([testSeriesId, availableFrom])
}

model MockTestQuestion {
  id         String   @id @default(cuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)

  @@unique([mockTestId, questionId])
}

// ---------------------------------------------------------------------------
// Test Resources — Paper PDF / Solution PDF / OMR templates.
//
// One reusable model rather than one-off hardcoded files: a Paper/Solution
// PDF is always mockTestId-scoped (1:1 per test), while an OMR template can
// be assigned at any of mockTestId / testSeriesId / examId, or left fully
// global (all three null) so the same "OMR — 100 Questions" resource is
// reusable across the Student Dashboard, Test Series, an individual Mock
// Test, and the Public Exam Page without duplicating the file. Resolution
// order when looking up "which resource applies here" is
// mockTestId -> testSeriesId -> examId -> global (see lib/test-resources-access.ts).
// ---------------------------------------------------------------------------

enum TestResourceType {
  PAPER_PDF
  SOLUTION_PDF
  OMR_TEMPLATE
}

// Governs when a PAPER_PDF/SOLUTION_PDF becomes downloadable. Enforced only
// server-side in the download route (lib/test-resources-access.ts) — never
// inferred from a client "unlocked" flag. Ignored (treated as always
// visible-if-isActive) for OMR_TEMPLATE resources, which carry no exam
// secrecy concern.
enum ResourceReleasePolicy {
  AFTER_AVAILABLE_FROM
  AFTER_SUBMISSION
  CUSTOM_DATE
  DISABLED
}

model TestResource {
  id               String                @id @default(cuid())
  type             TestResourceType
  title            String
  fileUrl          String
  mimeType         String
  fileSizeBytes    Int
  // OMR templates only, e.g. 100/150/180/200 — the question count the sheet
  // is laid out for.
  questionCount    Int?
  isActive         Boolean               @default(true)
  order            Int                   @default(0)
  releasePolicy    ResourceReleasePolicy @default(AFTER_AVAILABLE_FROM)
  // Only consulted when releasePolicy = CUSTOM_DATE.
  releaseAt        DateTime?
  examId           String?
  exam             Exam?                 @relation(fields: [examId], references: [id], onDelete: SetNull)
  testSeriesId     String?
  testSeries       TestSeries?           @relation(fields: [testSeriesId], references: [id], onDelete: SetNull)
  mockTestId       String?
  mockTest         MockTest?             @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  createdByAdminId String?
  createdByAdmin   AdminUser?            @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([type, isActive])
  @@index([mockTestId, type])
  @@index([testSeriesId, type])
  @@index([examId, type])
}

// ---------------------------------------------------------------------------
// Custom Modules
//
// One canonical admin-owned CustomModule record — never duplicated per
// student. Manual mode links questions directly via CustomModuleQuestion;
// rule-based mode stores the rule in ruleConfig and resolves it into the
// same CustomModuleQuestion rows at publish/edit time, so the served list is
// always a concrete snapshot future attempts read from. Editing a module
// only affects attempts started after the edit — see TestAttemptQuestion.
// ---------------------------------------------------------------------------

enum CustomModuleStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SelectionMode {
  MANUAL
  RULE_BASED
}

model CustomModule {
  id                 String             @id @default(cuid())
  examId             String
  exam               Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  selectionMode      SelectionMode      @default(MANUAL)
  ruleConfig         Json?
  durationMinutes    Int?
  negativeMarking    Float              @default(0)
  instructions       String?
  accessType         AccessType         @default(FREE)
  status             CustomModuleStatus @default(DRAFT)
  order              Int                @default(0)
  createdByAdminId   String?
  createdByAdmin     AdminUser?         @relation(fields: [createdByAdminId], references: [id])
  // Student-driven custom modules. The question set is still resolved once
  // into CustomModuleQuestion (the immutable snapshot students practice), the
  // owner is remembered for "My Modules", and shareToken is an opaque,
  // non-guessable link that never exposes the internal id.
  createdByStudentId String?
  createdByStudent   Student?           @relation("StudentCustomModules", fields: [createdByStudentId], references: [id])
  isStudentOwned     Boolean            @default(false)
  shareToken         String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  questions    CustomModuleQuestion[]
  testAttempts TestAttempt[]

  @@index([examId, status])
  @@index([createdByStudentId])
}

model CustomModuleQuestion {
  id             String       @id @default(cuid())
  customModuleId String
  customModule   CustomModule @relation(fields: [customModuleId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id])
  order          Int          @default(0)

  @@unique([customModuleId, questionId])
}

// ---------------------------------------------------------------------------
// Grand Tests
//
// Admin-configurable, exam-scoped full-length tests with a question-selection
// rule (subjects / topics / difficulty). On Publish the rule is resolved ONCE
// into GrandTestQuestion — the immutable, ordered set every student sees.
// Attempts run through the unified TestAttempt engine (testType GRAND_TEST).
// ---------------------------------------------------------------------------

enum GrandTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model GrandTest {
  id               String          @id @default(cuid())
  examId           String
  exam             Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  durationMinutes  Int
  negativeMarking  Float           @default(0)
  instructions     String?
  accessType       AccessType      @default(FREE)
  status           GrandTestStatus @default(DRAFT)
  questionCount    Int
  // Deprecated flat-filter rule, superseded by `blueprint` below. Never
  // written by app code as of Step 4; kept only for schema continuity.
  subjects         Json?
  topics           Json?
  difficulty       Json?
  // Per-subject blueprint, resolved into GrandTestQuestion at publish time.
  // Shape: [{ subjectId: string; topicId?: string; subTopicId?: string;
  //           difficulty?: QuestionDifficulty[]; count: number }]
  // The sum of every line's `count` must equal `questionCount`.
  blueprint        Json?
  order            Int             @default(0)
  publishedAt      DateTime?
  createdByAdminId String?
  createdByAdmin   AdminUser?      @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  questions     GrandTestQuestion[]
  testAttempts  TestAttempt[]
  announcements Announcement[]

  products Product[]

  @@index([examId, status])
}

model GrandTestQuestion {
  id          String    @id @default(cuid())
  grandTestId String
  grandTest   GrandTest @relation(fields: [grandTestId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id])
  order       Int       @default(0)

  @@unique([grandTestId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Live / Scheduled Tests
//
// A global test window (startAt → endAt) shared by every student, plus a
// per-student duration cap. LIVE state is DERIVED from authoritative server
// time (see lib/attempt-timing.ts), never from the browser. On Publish the
// selection rule is resolved once into LiveTestQuestion (same immutable-set
// guarantee as GrandTest). Attempts run through the unified engine with
// testType LIVE_TEST; effective end = min(started+duration, global endAt).
// ---------------------------------------------------------------------------

enum LiveTestStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  RESULT_PUBLISHED
  CANCELLED
}

model LiveTest {
  id                     String         @id @default(cuid())
  examId                 String
  exam                   Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  startAt                DateTime
  endAt                  DateTime
  studentDurationMinutes Int
  negativeMarking        Float          @default(0)
  instructions           String?
  accessType             AccessType     @default(FREE)
  status                 LiveTestStatus @default(DRAFT)
  questionCount          Int
  // Deprecated flat-filter rule, superseded by `blueprint` below (same
  // Step 4 → Step 5 continuity as GrandTest.subjects/topics/difficulty).
  // Never written by app code as of Step 5; kept only for schema continuity.
  subjects               Json?
  topics                 Json?
  difficulty             Json?
  // Per-subject blueprint, resolved into LiveTestQuestion when the test is
  // locked (SCHEDULED). Shape identical to GrandTest.blueprint:
  // [{ subjectId: string; topicId?: string; subTopicId?: string;
  //    difficulty?: QuestionDifficulty[]; count: number }]
  // The sum of every line's `count` must equal `questionCount`.
  blueprint              Json?
  order                  Int            @default(0)
  publishedAt            DateTime?
  createdByAdminId       String?
  createdByAdmin         AdminUser?     @relation(fields: [createdByAdminId], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  questions     LiveTestQuestion[]
  testAttempts  TestAttempt[]
  announcements Announcement[]

  products Product[]

  @@index([status, startAt])
  @@index([examId, status])
}

model LiveTestQuestion {
  id         String   @id @default(cuid())
  liveTestId String
  liveTest   LiveTest @relation(fields: [liveTestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)

  @@unique([liveTestId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Test Attempts
//
// Unifies Mock Test / Previous Year Paper / Custom Module / Subject / Grand /
// Live attempts under one table so History and admin analytics have one place
// to read from. TestAttemptQuestion.questionSnapshot freezes the
// question/options as they were at attempt-start, so later admin edits never
// change past results. testType identifies the production-facing test kind.
// ---------------------------------------------------------------------------

enum AttemptSourceType {
  MOCK_TEST
  PREVIOUS_YEAR_PAPER
  CUSTOM_MODULE
  SUBJECT_TEST
  GRAND_TEST
  LIVE_TEST
}

/**
 * Production-facing test type carried on every attempt. Maps onto
 * AttemptSourceType for the legacy sources (FULL_MOCK ⇄ MOCK_TEST,
 * CUSTOM_MODULE ⇄ CUSTOM_MODULE, PREVIOUS_YEAR_PAPER ⇄ PREVIOUS_YEAR_PAPER)
 * and adds the newer first-class types. All types run through the same
 * TestAttempt / TestAttemptQuestion / Answer engine.
 */
enum TestType {
  FULL_MOCK
  SUBJECT_TEST
  GRAND_TEST
  LIVE_TEST
  PREVIOUS_YEAR_PAPER
  CUSTOM_MODULE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum AttemptEntryMode {
  ONLINE
  OFFLINE_OMR_ENTRY
}

enum AnswerStatus {
  UNANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED
}

model TestAttempt {
  id                   String             @id @default(cuid())
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceType           AttemptSourceType
  testType             TestType           @default(FULL_MOCK)
  examId               String
  exam                 Exam               @relation(fields: [examId], references: [id])
  mockTestId           String?
  mockTest             MockTest?          @relation(fields: [mockTestId], references: [id])
  previousYearPaperId  String?
  previousYearPaper    PreviousYearPaper? @relation(fields: [previousYearPaperId], references: [id])
  customModuleId       String?
  customModule         CustomModule?      @relation(fields: [customModuleId], references: [id])
  // Subject-test linkage (recorded so resume/analytics know the selection).
  subjectId            String?
  subject              Subject?           @relation(fields: [subjectId], references: [id])
  topicIds             Json?
  // The exact filters a student chose when the attempt was generated, kept so
  // the attempt is self-describing and resume never needs to re-resolve the
  // question set (the set itself is frozen in TestAttemptQuestion). Shape:
  // { year?: number; source?: QuestionSource; difficulty?: QuestionDifficulty[];
  //   subTopicIds?: string[] }. All types may populate it in a later step.
  selection            Json?
  // Grand / Live test linkage.
  grandTestId          String?
  grandTest            GrandTest?         @relation(fields: [grandTestId], references: [id])
  liveTestId           String?
  liveTest             LiveTest?          @relation(fields: [liveTestId], references: [id])
  status               AttemptStatus      @default(IN_PROGRESS)
  durationMinutes      Int
  negativeMarking      Float              @default(0)
  totalQuestions       Int
  correctCount         Int?
  incorrectCount       Int?
  unansweredCount      Int?
  score                Float?
  maxScore             Float?
  timeTakenSeconds     Int?
  // How this attempt's answers were captured. ONLINE (default) is the
  // existing in-browser test player. OFFLINE_OMR_ENTRY marks an attempt
  // created for the Offline OMR Answer Entry flow (student printed the
  // Paper PDF + OMR, then keys in answers afterward) — it still runs through
  // the exact same createAttemptFromQuestions/saveAnswer/submitAttempt path,
  // this field only labels the source for UI/audit purposes.
  entryMode            AttemptEntryMode   @default(ONLINE)
  // Set exactly once, on the first attempt for a given (studentId, mockTestId)
  // pair to reach SUBMITTED. Never recomputed and never a rank — it only
  // classifies which attempt counts for the leaderboard, so retakes under
  // AttemptPolicy.MULTIPLE_PRACTICE never displace a student's original
  // leaderboard position. See lib/leaderboard.ts.
  isLeaderboardAttempt Boolean            @default(false)
  startedAt            DateTime           @default(now())
  submittedAt          DateTime?
  createdAt            DateTime           @default(now())

  questions TestAttemptQuestion[]
  answers   Answer[]

  @@index([studentId, sourceType])
  @@index([studentId, status, testType])
  @@index([studentId, examId, status])
  @@index([testType, status])
  @@index([examId, status])
  @@index([customModuleId])
  @@index([mockTestId])
  @@index([previousYearPaperId])
  @@index([subjectId])
  @@index([grandTestId])
  @@index([liveTestId])
  @@index([mockTestId, isLeaderboardAttempt, status])
}

model TestAttemptQuestion {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  order            Int         @default(0)
  questionSnapshot Json

  answer Answer?

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Answer {
  id                  String              @id @default(cuid())
  attemptId           String
  attempt             TestAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestionId   String              @unique
  attemptQuestion     TestAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId          String
  selectedOptionLabel String?
  isCorrect           Boolean?
  status              AnswerStatus        @default(UNANSWERED)
  answeredAt          DateTime?

  @@index([studentId])
  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Exam enrollment
//
// Optional, additive: "My Exams" shows exams a student has opted into. Access
// is NOT gated on enrollment today (free/demo admin behavior must keep
// working), but the record gives students a focused list and analytics a
// first-class "my exams" dimension.
// ---------------------------------------------------------------------------

model StudentExamEnrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, examId])
  @@index([examId])
}

// ---------------------------------------------------------------------------
// Saved Questions / History / Reports / AI Explanations
// ---------------------------------------------------------------------------

model SavedQuestion {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, questionId])
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  // Admin AI Usage aggregates across ALL students by `activity`
  // (AI_EXPLANATION_VIEWED / AI_EXPLANATION_GENERATED) — this index keeps
  // that query from scanning every StudentActivity row.
  @@index([activity, createdAt])
}

enum ReportType {
  WRONG_ANSWER
  WRONG_QUESTION
  INCORRECT_EXPLANATION
  IMAGE_ISSUE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model ReportedQuestion {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptId      String?
  customModuleId String?
  reportType     ReportType   @default(OTHER)
  message        String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?

  @@index([status])
  @@index([questionId])
}

model AIExplanation {
  id            String             @id @default(cuid())
  questionId    String             @unique
  question      Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content       Json
  model         String
  // One-shot lifecycle used to prevent duplicate concurrent generation for
  // the same question and to surface failures to the admin panel.
  status        AiGenerationStatus @default(COMPLETED)
  provider      String             @default("anthropic")
  promptVersion String?
  generatedAt   DateTime?
  retryCount    Int                @default(0)
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Versioning: this row is always the current/active version. An explicit
  // admin Regenerate snapshots the outgoing content into AIExplanationVersion
  // before overwriting, so `version` only ever moves forward and old content
  // is never silently lost.
  version           Int        @default(1)
  adminReviewedAt   DateTime?
  adminReviewedById String?
  adminReviewedBy   AdminUser? @relation("AiExplanationReviewedBy", fields: [adminReviewedById], references: [id])

  // Set true when the canonical Question's text/options/correct answer
  // changes after this explanation was generated (see
  // app/admin/(dashboard)/questions/actions.ts#flagStaleIfChanged). The
  // cached content is still served (never silently dropped) but Admin AI
  // Solutions surfaces "AI STALE" and the homepage demo excludes it until an
  // explicit Regenerate. Cleared back to false whenever generation completes.
  isStale Boolean @default(false)

  versions AIExplanationVersion[]
}

/**
 * Alternate-tone/style explanation for a question, distinct from the single
 * default AIExplanation above — e.g. "Simpler Explanation" or "Step-by-Step
 * Breakdown". A separate model (not a variant dimension bolted onto
 * AIExplanation) so the default explanation's cache/versioning/staleness
 * logic never has to account for a variant axis. `variantId` is one of a
 * small fixed, code-defined catalog (see lib/ai-explanation-variants.ts) —
 * never arbitrary client input — capped at 5 variants per question by that
 * catalog's length, enforced again in code. Global per (question, variant)
 * cache, generated once on first student request and reused by every
 * student after that, mirroring AIExplanation's cache semantics exactly.
 */
model AIExplanationVariant {
  id           String             @id @default(cuid())
  questionId   String
  question     Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  variantId    String
  content      Json
  model        String
  provider     String             @default("anthropic")
  status       AiGenerationStatus @default(COMPLETED)
  errorMessage String?
  generatedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Same staleness semantics as AIExplanation.isStale above: set true when
  // the canonical Question's text/options/correct answer changes after this
  // variant was generated (lib/ai-explanation.ts#flagExplanationStaleIfExists
  // flags every variant row for the question alongside the default
  // explanation). The cached content is still served as-is; this only
  // surfaces a "may be outdated" notice to the student.
  isStale Boolean @default(false)

  @@unique([questionId, variantId])
  @@index([questionId])
}

/**
 * Append-only history of superseded AIExplanation content, written only when
 * an admin explicitly regenerates an already-COMPLETED explanation (never on
 * an ordinary first generation or a FAILED retry). Read-only from the app's
 * perspective — nothing ever updates a row here.
 */
model AIExplanationVersion {
  id            String        @id @default(cuid())
  explanationId String
  explanation   AIExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  version       Int
  content       Json
  model         String
  provider      String
  promptVersion String?
  generatedAt   DateTime?
  supersededAt  DateTime      @default(now())

  @@index([explanationId, version])
}

// ---------------------------------------------------------------------------
// Bulk Import History
//
// Tracks every bulk import run and its constituent rows for audit trail and
// debugging. Each run can have thousands of rows, so row-level detail is in
// BulkImportRow.
// ---------------------------------------------------------------------------

enum BulkImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
  // Staging-phase statuses (Validate & Preview Workspace). A run now exists
  // from the moment a file is uploaded — not only at final import — so it
  // has a stable batch identity/history entry throughout the workflow.
  UPLOADED
  VALIDATING
  READY
  IMPORTED
  PARTIALLY_IMPORTED
}

enum BulkImportRowStatus {
  PENDING
  SUCCESS
  SKIPPED
  REPLACED
  FAILED
}

/**
 * Validation severity for a staged row, independent of its final processing BulkImportRowStatus.
 */
enum ImportRowSeverity {
  VALID
  WARNING
  ERROR
}

/**
 * Structured format of the uploaded bulk-import source file.
 */
enum ImportFileFormat {
  CSV
  XLS
  XLSX
  DOCX
}

enum BulkImportDuplicateStrategy {
  SKIP
  REPLACE
  ADD_AS_NEW
}

model BulkImportRun {
  id                  String                      @id @default(cuid())
  adminUserId         String
  adminUser           AdminUser                   @relation(fields: [adminUserId], references: [id])
  filename            String
  format              ImportFileFormat?
  // Human-readable batch identity, e.g. "NEET UG 2026 — Code 12". Optional
  // exam context lets Admin filter/select an entire uploaded file's
  // questions later from All Questions.
  label               String?
  examId              String?
  exam                Exam?                       @relation(fields: [examId], references: [id], onDelete: SetNull)
  examYear            Int?
  // Optional Previous Year Paper the whole run should link its successfully
  // imported questions to (Section 21). Never required — most imports go
  // straight to the Question Bank and get linked to a paper later.
  previousYearPaperId String?
  previousYearPaper   PreviousYearPaper?          @relation(fields: [previousYearPaperId], references: [id], onDelete: SetNull)
  totalRows           Int
  validRows           Int                         @default(0)
  invalidRows         Int                         @default(0)
  warningRows         Int                         @default(0)
  successCount        Int                         @default(0)
  skippedCount        Int                         @default(0)
  replacedCount       Int                         @default(0)
  failedCount         Int                         @default(0)
  draftCount          Int                         @default(0)
  reviewRequiredCount Int                         @default(0)
  duplicateStrategy   BulkImportDuplicateStrategy
  status              BulkImportStatus            @default(PENDING)
  startedAt           DateTime                    @default(now())
  completedAt         DateTime?
  errorMessage        String?
  createdAt           DateTime                    @default(now())

  rows              BulkImportRow[]
  importedQuestions Question[]

  @@index([adminUserId, createdAt])
  @@index([status, createdAt])
  @@index([examId, examYear])
  @@index([previousYearPaperId])
}

model BulkImportRow {
  id                String              @id @default(cuid())
  runId             String
  run               BulkImportRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  rowNumber         Int
  status            BulkImportRowStatus @default(PENDING)
  severity          ImportRowSeverity   @default(ERROR)
  questionId        String?
  questionCode      String?
  errorMessage      String?
  // Structured per-row messages (string[] each), richer than the single
  // legacy errorMessage above — powers the Validate & Preview Workspace.
  errors            Json?
  warnings          Json?
  rawData           Json
  // Admin's inline corrections overlaid onto rawData before
  // import/revalidation; null until the row has been edited.
  editedData        Json?
  removedFromImport Boolean             @default(false)
  reviewRequired    Boolean             @default(false)
  // Per-row override of the status the resulting Question should get on
  // import (e.g. explicit "Save as Draft"); null = use the run's default.
  targetStatus      QuestionStatus?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([runId, rowNumber])
  @@index([runId, status])
  @@index([runId, severity])
}

// ---------------------------------------------------------------------------
// Announcements / Student Notifications
//
// One Announcement row per broadcast — never duplicated per student. Audience
// is resolved server-side at read time (lib/notifications.ts): ALL_STUDENTS /
// EXAM_STUDENTS (via StudentExamEnrollment) / ACTIVE_STUDENTS (Student.status)
// / SELECTED_STUDENTS (explicit AnnouncementRecipient rows). A student's
// read/unread state is a separate, lazily-created row (StudentNotificationState)
// keyed by (studentId, announcementId) — one announcement reaching thousands
// of students costs one row, not thousands, until each student actually
// opens or marks it.
//
// Visibility is derived from server time exactly like LiveTest
// (see lib/live-test.ts / lib/notifications.ts): status PUBLISHED AND
// (publishAt is null or in the past) AND (expiresAt is null or in the
// future). DRAFT and ARCHIVED never resolve as visible regardless of dates.
// ---------------------------------------------------------------------------

enum AnnouncementType {
  GENERAL
  IMPORTANT
  EXAM_UPDATE
  NEW_TEST
  LIVE_TEST
  RESULT
  MAINTENANCE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

enum AnnouncementAudience {
  ALL_STUDENTS
  EXAM_STUDENTS
  ACTIVE_STUDENTS
  SELECTED_STUDENTS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id               String               @id @default(cuid())
  title            String
  message          String
  content          String?
  type             AnnouncementType     @default(GENERAL)
  priority         AnnouncementPriority @default(NORMAL)
  audience         AnnouncementAudience @default(ALL_STUDENTS)
  examId           String?
  exam             Exam?                @relation(fields: [examId], references: [id])
  mockTestId       String?
  mockTest         MockTest?            @relation(fields: [mockTestId], references: [id])
  grandTestId      String?
  grandTest        GrandTest?           @relation(fields: [grandTestId], references: [id])
  liveTestId       String?
  liveTest         LiveTest?            @relation(fields: [liveTestId], references: [id])
  ctaLabel         String?
  ctaRoute         String?
  showOnDashboard  Boolean              @default(false)
  status           AnnouncementStatus   @default(DRAFT)
  publishAt        DateTime?
  expiresAt        DateTime?
  createdByAdminId String?
  createdByAdmin   AdminUser?           @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  recipients AnnouncementRecipient[]
  reads      StudentNotificationState[]

  @@index([status, publishAt])
  @@index([status, expiresAt])
  @@index([audience, examId])
  @@index([examId])
  @@index([showOnDashboard, status])
}

/**
 * Explicit recipient list — only populated/consulted when audience = SELECTED_STUDENTS.
 */
model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, studentId])
  @@index([studentId])
}

/**
 * Lazily created: absent row (or readAt null) means unread. Upserted, never double-inserted (unique constraint absorbs the two-PM2-worker race).
 */
model StudentNotificationState {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, announcementId])
  @@index([studentId, readAt])
  @@index([announcementId])
}

// ---------------------------------------------------------------------------
// Communications — the single canonical inbound-message store behind the
// public Contact Us / Message Us and Grow With Us forms, and Admin →
// Communications. Distinct from Announcement (outbound, Admin → Students).
// ---------------------------------------------------------------------------

enum CommunicationType {
  CONTACT
  GROW_WITH_US
}

enum CommunicationStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum GrowWithUsInterest {
  TEACHER
  TEST_SERIES_CREATOR
  IT_SUPPORT
  CONTENT_CONTRIBUTOR
  OTHER
}

/**
 * One row per public submission from Contact Us → Message Us, or from the
 * sitewide Grow With Us dialog. `referenceId` is shown to the submitter as
 * their tracking reference and never doubles as the primary key so it can
 * be regenerated/formatted independently of storage. `studentId` is set
 * only when the submitter was signed in at submit time (derived from the
 * server-side session, never from client input) — the form still works for
 * anonymous public visitors.
 */
model Communication {
  id              String              @id @default(cuid())
  referenceId     String              @unique
  type            CommunicationType
  interestType    GrowWithUsInterest?
  name            String
  email           String
  phone           String?
  subject         String?
  message         String
  status          CommunicationStatus @default(NEW)
  internalNote    String?
  studentId       String?
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assignedAdminId String?
  assignedAdmin   AdminUser?          @relation(fields: [assignedAdminId], references: [id])
  ipAddress       String?
  userAgent       String?
  readAt          DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([type, status, createdAt])
  @@index([status])
  @@index([email])
  @@index([ipAddress, createdAt])
}

// ---------------------------------------------------------------------------
// Commerce — Products, Pricing, Coupons, Orders, Payments, Entitlements,
// Invoices, Refunds, Webhooks (Razorpay Standard Checkout).
//
// Money is ALWAYS integer paise — never Float. Every price shown to or
// charged from a student is recomputed server-side from Product/Coupon rows
// (lib/payments/pricing.ts); the browser only ever sends identifiers.
//
// Access control is the Entitlement layer (lib/payments/access.ts), not
// Payment rows: a captured payment grants a StudentEntitlement, and every
// protected TestAttempt start checks entitlements — never payments directly.
// The global FREE / PAID / MAINTENANCE switch lives in Setting
// `payments.mode` (lib/payments/settings.ts) so it is Admin-controlled with
// no deploy, and flipping it never deletes historical commerce rows.
// ---------------------------------------------------------------------------

enum ProductType {
  EXAM_ACCESS
  TEST_SERIES
  MOCK_TEST
  GRAND_TEST
  LIVE_TEST
  PYQ_PACKAGE
}

enum AccessDurationType {
  DAYS
  FIXED_DATE
  LIFETIME
}

enum SaleDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Product {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  description        String?
  productType        ProductType
  // What the product unlocks. EXAM_ACCESS / PYQ_PACKAGE use examId alone;
  // TEST_SERIES / MOCK_TEST / GRAND_TEST / LIVE_TEST also set their entity id.
  examId             String?
  exam               Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  testSeriesId       String?
  testSeries         TestSeries?        @relation(fields: [testSeriesId], references: [id], onDelete: SetNull)
  mockTestId         String?
  mockTest           MockTest?          @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  grandTestId        String?
  grandTest          GrandTest?         @relation(fields: [grandTestId], references: [id], onDelete: SetNull)
  liveTestId         String?
  liveTest           LiveTest?          @relation(fields: [liveTestId], references: [id], onDelete: SetNull)
  accessType         AccessType         @default(FREE)
  isActive           Boolean            @default(true)
  isVisible          Boolean            @default(true)
  purchaseEnabled    Boolean            @default(true)
  currency           String             @default("INR")
  mrpPaise           Int                @default(0)
  sellingPricePaise  Int                @default(0)
  // Time-boxed sale on top of sellingPricePaise ("Deal ends in ...").
  saleEnabled        Boolean            @default(false)
  saleDiscountType   SaleDiscountType?
  // PERCENTAGE: whole percent 1..100. FIXED_AMOUNT: paise.
  saleDiscountValue  Int?
  saleStartAt        DateTime?
  saleEndAt          DateTime?
  accessDurationType AccessDurationType @default(DAYS)
  accessDays         Int?
  accessExpiresAt    DateTime?
  order              Int                @default(0)
  createdByAdminId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entitlements StudentEntitlement[]
  orders       PaymentOrder[]

  @@index([productType, isActive])
  @@index([examId])
  @@index([testSeriesId])
  @@index([mockTestId])
  @@index([grandTestId])
  @@index([liveTestId])
}

enum EntitlementSource {
  FREE
  PURCHASE
  COUPON
  ADMIN_GRANT
  PROMOTION
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

// Expiry is derived from expiresAt vs server time — status only records
// explicit revocation, so no cron is needed to "expire" rows.
model StudentEntitlement {
  id               String            @id @default(cuid())
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  source           EntitlementSource
  status           EntitlementStatus @default(ACTIVE)
  startsAt         DateTime
  expiresAt        DateTime?
  // One entitlement per order, enforced by the DB — duplicate verify /
  // webhook / reconcile calls can never grant twice.
  orderId          String?           @unique
  order            PaymentOrder?     @relation(fields: [orderId], references: [id])
  grantedByAdminId String?
  reason           String?
  revokedAt        DateTime?
  revokedByAdminId String?
  revokeReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId, productId, status])
  @@index([productId])
  @@index([expiresAt])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_ACCESS
}

model Coupon {
  id                String             @id @default(cuid())
  // Stored upper-case; lookups normalise input the same way.
  code              String             @unique
  displayName       String?
  description       String?
  isActive          Boolean            @default(true)
  validFrom         DateTime?
  validUntil        DateTime?
  discountType      CouponDiscountType
  // PERCENTAGE: whole percent 1..100. FIXED_AMOUNT: paise. FREE_ACCESS: ignored.
  discountValue     Int                @default(0)
  maxDiscountPaise  Int?
  minOrderPaise     Int?
  totalUsageLimit   Int?
  perStudentLimit   Int?
  newStudentOnly    Boolean            @default(false)
  // Empty array = no restriction on that dimension.
  productIds        String[]           @default([])
  examIds           String[]           @default([])
  testSeriesIds     String[]           @default([])
  // Attribution foundation (a full referral program can hang off these).
  source            String?
  campaign          String?
  referrerName      String?
  referrerCode      String?
  referrerStudentId String?
  referrerAdminId   String?
  notes             String?
  createdByAdminId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  redemptions CouponRedemption[]
  orders      PaymentOrder[]

  @@index([isActive])
}

enum CouponRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model CouponRedemption {
  id            String                 @id @default(cuid())
  couponId      String
  coupon        Coupon                 @relation(fields: [couponId], references: [id])
  studentId     String
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  orderId       String                 @unique
  order         PaymentOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        CouponRedemptionStatus @default(RESERVED)
  discountPaise Int
  reservedUntil DateTime?
  consumedAt    DateTime?
  createdAt     DateTime               @default(now())

  @@index([couponId, status])
  @@index([couponId, studentId, status])
}

enum PaymentEnvironment {
  TEST
  LIVE
}

enum PaymentGateway {
  RAZORPAY
  INTERNAL
}

enum OrderStatus {
  CREATED
  GATEWAY_ORDER_CREATED
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PaymentOrder {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  status              OrderStatus        @default(CREATED)
  gateway             PaymentGateway
  environment         PaymentEnvironment
  currency            String             @default("INR")
  mrpPaise            Int
  sellingPricePaise   Int
  saleDiscountPaise   Int                @default(0)
  couponId            String?
  coupon              Coupon?            @relation(fields: [couponId], references: [id])
  couponCode          String?
  couponDiscountPaise Int                @default(0)
  amountPaise         Int
  // Frozen product/pricing facts at order time (name, access duration...).
  productSnapshot     Json
  gatewayOrderId      String?            @unique
  receipt             String             @unique
  // Non-null only while the order is open: `${studentId}:${productId}`.
  // The UNIQUE index makes "one open order per student+product" hold
  // across every PM2 worker, so double-click / two tabs reuse one order.
  openKey             String?            @unique
  failureReason       String?
  expiresAt           DateTime?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  payments         Payment[]
  entitlement      StudentEntitlement?
  couponRedemption CouponRedemption?
  invoice          Invoice?
  refunds          Refund[]

  @@index([studentId, createdAt])
  @@index([status, environment, createdAt])
  @@index([productId])
  @@index([couponId])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentVerifiedVia {
  CHECKOUT_SIGNATURE
  WEBHOOK
  RECONCILIATION
}

model Payment {
  id                 String              @id @default(cuid())
  orderId            String
  order              PaymentOrder        @relation(fields: [orderId], references: [id])
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id])
  gateway            PaymentGateway
  environment        PaymentEnvironment
  gatewayPaymentId   String              @unique
  status             PaymentStatus       @default(CREATED)
  amountPaise        Int
  currency           String              @default("INR")
  // Safe method label only ("upi", "card", "netbanking"...) — never card
  // numbers, VPA, CVV or OTPs.
  method             String?
  verifiedVia        PaymentVerifiedVia?
  refundedPaise      Int                 @default(0)
  failureCode        String?
  failureDescription String?
  capturedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([studentId, createdAt])
  @@index([status, environment, createdAt])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

enum RefundAccessPolicy {
  REVOKE_IMMEDIATELY
  RETAIN_UNTIL_DATE
  RETAIN
}

model Refund {
  id                 String             @id @default(cuid())
  paymentId          String
  payment            Payment            @relation(fields: [paymentId], references: [id])
  orderId            String
  order              PaymentOrder       @relation(fields: [orderId], references: [id])
  gatewayRefundId    String?            @unique
  amountPaise        Int
  status             RefundStatus       @default(REQUESTED)
  reason             String?
  accessPolicy       RefundAccessPolicy @default(RETAIN)
  retainUntil        DateTime?
  requestedByAdminId String?
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Invoice {
  id            String             @id @default(cuid())
  invoiceNumber String             @unique
  orderId       String             @unique
  order         PaymentOrder       @relation(fields: [orderId], references: [id])
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id])
  environment   PaymentEnvironment
  totalPaise    Int
  currency      String             @default("INR")
  // Immutable snapshot: seller, customer, lines, tax, totals, payment ref.
  snapshot      Json
  issuedAt      DateTime           @default(now())

  @@index([studentId, issuedAt])
}

// Atomic per-series counter for invoice numbers (key = prefix + FY).
model InvoiceCounter {
  key   String @id
  value Int    @default(0)
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model PaymentWebhookEvent {
  id            String              @id @default(cuid())
  provider      PaymentGateway      @default(RAZORPAY)
  // Razorpay's x-razorpay-event-id header — the dedup key.
  eventId       String              @unique
  eventType     String
  environment   PaymentEnvironment?
  status        WebhookEventStatus  @default(RECEIVED)
  orderId       String?
  paymentId     String?
  errorCategory String?
  // Safe subset only (ids, status, amount) — never the raw payload.
  summary       Json?
  receivedAt    DateTime            @default(now())
  processedAt   DateTime?

  @@index([eventType, receivedAt])
  @@index([orderId])
}

// DB-backed sliding-window rate limit shared by every PM2 worker.
model PaymentRateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  key       String
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
}

// ---------------------------------------------------------------------------
// Backup & Disaster Recovery Center (Admin -> Backup). Lightweight metadata
// only — archive contents, passphrases and credentials are never stored.
// Backup files themselves live on disk under allowlisted roots
// (lib/backup/roots.ts); filesystem discovery works even without a row here.
// ---------------------------------------------------------------------------

enum BackupKind {
  FULL
  CLEAN
  DATABASE
}

enum BackupJobStatus {
  RUNNING
  READY
  DOWNLOADED
  SAVED
  FAILED
  EXPIRED
  DELETED
}

model BackupJob {
  id               String          @id @default(cuid())
  kind             BackupKind
  status           BackupJobStatus @default(RUNNING)
  // Non-null only while RUNNING — the UNIQUE index is the cross-worker lock
  // allowing one backup generation at a time on this VPS.
  lockKey          String?         @unique
  saveOnVps        Boolean         @default(false)
  fileName         String?
  sizeBytes        BigInt?
  sha256           String?
  // Safe summary of manifest components (no secrets, no contents).
  summary          Json?
  error            String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  finishedAt       DateTime?
  downloadedAt     DateTime?
  deletedAt        DateTime?
  storageFreed     BigInt?

  @@index([createdAt])
  @@index([status])
}

enum BackupVerifyStatus {
  VALID
  LEGACY_VERIFIED
  LEGACY_UNVERIFIED
  INVALID
  CORRUPT
  INCOMPATIBLE
}

// Cached verification result per discovered artifact, invalidated when the
// file's size/mtime changes.
model BackupArtifactCheck {
  artifactId String             @id
  fileName   String
  sizeBytes  BigInt
  mtimeMs    BigInt
  status     BackupVerifyStatus
  detail     String?
  sha256     String?
  checkedAt  DateTime           @default(now())
}
